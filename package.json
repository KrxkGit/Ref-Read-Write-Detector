{
  "name": "ref-read-write-detector",
  "displayName": "ref-read-write-detector",
  "description": "",
  "version": "1.0.5",
  "engines": {
    "vscode": "^1.100.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "publisher": "krxk",
  "repository": {
    "type": "git",
    "url": "https://github.com/KrxkGit/Ref-Read-Write-Detector.git"
  },
  "icon": "media/app-icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ref-detector-sidebar",
          "title": "Ref Detector",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "ref-detector-sidebar": [
        {
          "id": "refWriteView",
          "name": "%view.name%"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ref-read-write-detector.analyze",
        "key": "alt+cmd+f7",
        "mac": "alt+cmd+f7",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "ref-read-write-detector.analyze",
        "title": "%command.analyze%"
      },
      {
        "command": "ref-read-write-detector.clear",
        "title": "%command.clear%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ref-read-write-detector.analyze",
          "when": "editorTextFocus",
          "group": "navigation@1.5"
        }
      ],
      "view/title": [
        {
          "command": "ref-read-write-detector.clear",
          "when": "view == refWriteView",
          "group": "navigation"
        }
      ]
    },
    "configuration": [
      {
        "title": "ref-read-write-detector",
        "properties": {
          "ref-read-write-detector.customMutatingPrefixes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "set",
              "add",
              "remove",
              "insert",
              "delete",
              "update",
              "append",
              "replace",
              "clear",
              "reset",
              "sort",
              "exchange"
            ],
            "description": "%setting.customMutatingPrefixes%"
          },
          "ref-read-write-detector.customMutatingPrompt": {
            "type": "string",
            "default": "【Mutating】",
            "description": "%setting.customMutatingPrompt%"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}